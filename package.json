{
  "name": "@buff/ui",
  "private": true,
  "version": "0.2.3",
  "license": "MIT",
  "type": "module",
  "description": "Buff design system: platform-neutral tokens, composite CSS classes, React components (#561). Shipped as source: the consumer's bundler compiles it.",
  "exports": {
    "./react": "./src/react/index.ts",
    "./native": "./src/native/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./locale": "./src/shared/locale.ts",
    "./ui.css": "./styles/ui.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./tokens.css": "./styles/tokens.css"
  },
  "files": [
    "src",
    "styles"
  ],
  "scripts": {
    "gen": "node scripts/gen-css.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
